# VCS
.git

# GitHub metadata (not needed in image)
.github

# Local env files (never bake into image)
.env
.env.*
*.env

# IDE / editor
.idea
.vscode

# Python caches
__pycache__
*.py[cod]
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache
.cache
htmlcov
.coverage

# Virtual environments
.venv
venv

# Build artifacts
build
dist
*.egg-info

# OS
.DS_Store

# Data files (large, not needed in image)
data/*.xlsx
data/*.csv
*.xlsx
*.csv

# Model caches (will be downloaded on first run)
.fastembed_cache
*.onnx

# Documentation
*.md
!README.md

# Test files
tests
*_test.py
test_*.py

# Credentials (should be mounted at runtime)
credentials
