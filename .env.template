# =============================================================================
# Review Summary AI - 환경 변수 템플릿
# =============================================================================
#
# 사용법:
# 1. 이 파일을 .env로 복사
# 2. 1Password CLI로 실제 값 주입:
#    op inject -i .env.template -o .env
#
# 또는 run_with_secrets.sh 스크립트 사용
# =============================================================================

# OpenAI API Key (필수 - GPT-4o-mini 사용)
OPENAI_API_KEY=op://Dev/OpenAI API/credential
OPENAI_ORG_ID=your-organization-id
OPENAI_PROJECT_ID=your-project-id

# Gemini API Key (사용 안함)
# GEMINI_API_KEY=op://Dev/Gemini API/credential

# LLM Provider 설정 (openai / gemini / ollama)
LLM_PROVIDER=openai

# =============================================================================
# 회사 내부 API (Carmore)
# =============================================================================
# Carmore Budget API Host
CARMORE_BUDGET_API_HOST=your-carmore-api-host

# Carmore API Key (필요시)
CARMORE_API_KEY=your-carmore-api-key
